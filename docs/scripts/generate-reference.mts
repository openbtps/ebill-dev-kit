// Writes the reference pages that come from the code, so they are never written by hand: the webhook topics from the
// SDK's own catalogue, and the CLI from its own help. Run before the site builds (package.json, "build").
import { mkdir, writeFile } from "node:fs/promises";
import { fileURLToPath } from "node:url";
import { SCOPES, TOPICS } from "@ebilladdress/app-sdk";
import { run } from "@ebilladdress/cli";

const OUT = fileURLToPath(new URL("../docs/reference/generated/", import.meta.url));
// An MDX comment: MDX refuses an HTML one.
const NOTICE = "{/* Generated by docs/scripts/generate-reference.mts from the code. Do not edit: change the code. */}";

// What each topic's `data` holds (CONTRACT.md, "Topics"): the shape, by the family the topic belongs to.
const DATA: Record<string, string> = {
  document: "`{ documentId, kind, direction, from, to, at }`",
  payment: "`{ documentId, eventId, event, direction, at }`",
  "app.settings.updated": "`{ values }`",
  app: "`{}`",
};

function dataOf(topic: string): string {
  return DATA[topic] ?? DATA[topic.split(".")[0] ?? ""] ?? "";
}

function topicsPage(): string {
  const rows = Object.entries(TOPICS).map(([topic, scope]) => `| \`${topic}\` | ${scope ? `\`${scope}\`` : "none"} | ${dataOf(topic)} |`);
  const scopes = Object.entries(SCOPES).map(([scope, label]) => `| \`${scope}\` | ${label} |`);
  return [
    "---",
    "title: Webhook topics",
    "---",
    "",
    NOTICE,
    "",
    "# Webhook topics",
    "",
    "| Topic | Scope needed | `data` |",
    "| --- | --- | --- |",
    ...rows,
    "",
    "`kind` is the document type, for example `invoice`. `direction` is `outgoing` or `incoming`. `at` is when it happened.",
    "Payment events are thin on purpose: read the payment at `GET /v1/documents/{documentId}/payment`.",
    "",
    "## Scopes",
    "",
    "| Scope | What the person installing your app is told |",
    "| --- | --- |",
    ...scopes,
    "",
  ].join("\n");
}

async function helpOf(argv: string[]): Promise<string> {
  let out = "";
  await run([...argv, "--help"], { stdout: (text) => (out += text), stderr: (text) => (out += text), cwd: process.cwd(), env: {} });
  return out.trimEnd();
}

async function cliPage(): Promise<string> {
  const commands = [
    ["app", "init"],
    ["app", "validate"],
    ["login"],
    ["logout"],
    ["app", "dev"],
    ["app", "deploy"],
    ["app", "versions"],
    ["app", "release"],
    ["app", "rollback"],
    ["app", "status"],
  ];
  const sections = await Promise.all(commands.map(async (argv) => `## \`ebill ${argv.join(" ")}\`\n\n\`\`\`text\n${await helpOf(argv)}\n\`\`\`\n`));
  return ["---", "title: CLI", "---", "", NOTICE, "", "# The `ebill` command", "", "```text", await helpOf([]), "```", "", ...sections].join("\n");
}

await mkdir(OUT, { recursive: true });
await writeFile(new URL("webhook-topics.md", `file://${OUT}`), topicsPage());
await writeFile(new URL("cli.md", `file://${OUT}`), await cliPage());
